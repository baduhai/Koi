# Maintainer:      Martin Stibor <martin.von.reichenberg@protonmail.com>

pkgname='koi'
_pkgname='Koi'
pkgver=0.7
pkgrel=1
pkgdesc="Scheduled LIGHT/DARK Theme Switching for the KDE Plasma Desktop"
arch=('x86_64' 'aarch64')
url="https://github.com/baduhai/Koi"
license=('LGPL3')

depends=(
    'hicolor-icon-theme'
    'kconfig'
    'kconfigwidgets'
    'kcoreaddons'
    'kdbusaddons'
    'kguiaddons'
    'kwidgetsaddons'
    'kwindowsystem'
    'plasma-desktop'
    'plasma-integration'
    'plasma-workspace'
    'qt6-base'
    'qt6-svg')

makedepends=(
    'cmake'
    'desktop-file-utils'
    'extra-cmake-modules'
    'fdupes'
    'ninja'
    'vulkan-headers'
    'qt6-tools')

optdepends=(
    'xsettingsd: Apply settings to GTK applications on the fly'
    'kvantum: Powerful extra customisable themes')

source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/${pkgver}.tar.gz")
sha512sums=('SKIP')

build() {
    cd "${_pkgname}-${pkgver}/"

    cmake -S '.' -B './build/' -G 'Ninja' \
          -DCMAKE_BUILD_TYPE='RelWithDebInfo' \
          -DCMAKE_INSTALL_PREFIX:PATH='/usr/' \
          -DKDE_INSTALL_USE_QT_SYS_PATHS:BOOL='ON' \
          -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL='ON' \
          -DSHARE_INSTALL_PREFIX:PATH='/usr/share/'

    ninja -C './build/' -j "$(nproc)" -v
}

package() {
    cd "${_pkgname}-${pkgver}/"

    DESTDIR="${pkgdir}/" ninja install -C './build/' -v

    install -D -m 644 'LICENSE' "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

# Validate the desktop file structure against the final installed artifact
    desktop-file-validate "${pkgdir}/usr/share/applications/local.${_pkgname}DbusInterface.desktop"
#
# Find and Deduplicate files (if applicable)
    fdupes -s "${pkgdir}/"
#
}
